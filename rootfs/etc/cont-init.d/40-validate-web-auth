#!/bin/sh

set -eu

case "${WEB_AUTHENTICATION:-1}" in
    0|false|FALSE|no|NO)
        echo "ERROR: WEB_AUTHENTICATION must remain enabled for Banking4-Web." >&2
        exit 1
        ;;
esac

if [ -z "${WEB_AUTHENTICATION_USERNAME:-}" ] || [ -z "${WEB_AUTHENTICATION_PASSWORD:-}" ]; then
    echo "ERROR: set WEB_AUTHENTICATION_USERNAME and WEB_AUTHENTICATION_PASSWORD before starting Banking4-Web." >&2
    exit 1
fi

